# Produktionsbetrieb: Werte als Server-Umgebungsvariablen setzen.
NODE_ENV=production
PORT=4173
BIND=127.0.0.1
# Nur bei vertrauenswürdigem HTTPS-Reverse-Proxy aktivieren:
TRUST_PROXY=1
# ADMIN_USER und ADMIN_PASSWORD beim ersten Start sicher setzen.
# ADMIN_PASSWORD: mindestens 12 Zeichen. Kein Passwort hier hinterlegen.
# DATA_DIR=/dauerhafter/pfad/adventskalender-data
