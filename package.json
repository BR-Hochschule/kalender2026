{
  "name": "adventskalender",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Adventkalender für GitHub Pages mit täglicher Freigabe",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "start": "node server.mjs",
    "preview": "node start-local.mjs",
    "build:inhaltsvorschau": "node scripts/build-pages.mjs --inhaltsvorschau",
    "build:pages": "node scripts/build-pages.mjs",
    "test:pages": "node --test tests/pages.test.mjs",
    "test": "node --test tests/*.test.mjs",
    "set-password": "node server.mjs --set-password"
  }
}
